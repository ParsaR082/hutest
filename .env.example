# ─── Django Backend ───
SECRET_KEY=change-me-in-production-use-openssl-rand
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
USE_SQLITE=True

POSTGRES_DB=flavoro
POSTGRES_USER=flavoro
POSTGRES_PASSWORD=flavoro
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=hello@humazd.com

# SMS (OTP delivery). Leave SMS_BACKEND=console until real Kavenegar
# credentials exist -- OTP codes are logged instead of sent.
SMS_BACKEND=console
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# Payment gateway. Leave PAYMENT_GATEWAY=mock until a real ZarinPal
# merchant account exists -- payments auto-succeed for local testing.
PAYMENT_GATEWAY=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=http://localhost:3000/checkout/pay/callback/
ZARINPAL_SANDBOX=True

# ─── Next.js Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ASSET_VERSION=1
